APP_ENV=production
POSTGRES_DB=pulse
POSTGRES_USER=pulse
# Prefixo dos volumes. Instalações de antes do H2NODE Pulse: VOLUME_PREFIX=pulse-services
VOLUME_PREFIX=h2node-pulse
# Troque os exemplos pelo seu domínio e IP (ver docs/INSTALACAO.md). Mantenha 127.0.0.1: é usado pela checagem de saúde interna.
DJANGO_ALLOWED_HOSTS=suporte.empresa.example,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://suporte.empresa.example
# IP privado deste servidor; a porta só é aberta nele.
BIND_IP=192.168.10.20
HTTP_PORT=8086
UPSTREAM_SCHEME=https
APP_BASE_URL=https://suporte.empresa.example

# Bootstrap opt-in, executado após as migrações. Nunca redefine uma senha existente.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_PASSWORD=
# true dispensa a confirmação por e-mail só do admin inicial (o SMTP ainda não existe).
# Cadastros comuns continuam exigindo confirmação.
BOOTSTRAP_ADMIN_TRUST_EMAIL=false
# Opcional: nomes DNS exatos de SMTP autorizados, separados por vírgula.
SMTP_ALLOWED_HOSTS=
# Proxies confiáveis à frente da API (proxy reverso + gateway = 2). Define o IP registrado nos chamados com autorização.
TRUSTED_PROXY_COUNT=2

# Cloudflare Turnstile (login, cadastro e recuperação). Vazio = desativado; defina as duas chaves.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Backup cifrado via FTP (compose.backup.yaml; ver docs/BACKUP.md). Senhas ficam em secrets/.
BACKUP_FTP_HOST=
BACKUP_FTP_PORT=21
BACKUP_FTP_USER=
BACKUP_FTP_DIR=/pulse-backups
BACKUP_FTP_TLS=true
BACKUP_FTP_VERIFY_CERT=true
BACKUP_KEEP=14
BACKUP_AT=03:00
