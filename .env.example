APP_ENV=development
POSTGRES_DB=pulse
POSTGRES_USER=pulse
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8086,http://127.0.0.1:8086,http://localhost:5173
BIND_IP=127.0.0.1
HTTP_PORT=8086
UPSTREAM_SCHEME=http
APP_BASE_URL=http://localhost:8086

# Bootstrap opt-in, executado após as migrações. Nunca redefine uma senha existente.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_PASSWORD=
# Provisionamento pelo operador; dispensa confirmação por e-mail só do admin inicial.
# MFA permanece obrigatório. Cadastros comuns continuam exigindo confirmação.
BOOTSTRAP_ADMIN_TRUST_EMAIL=false
# Opcional: nomes DNS exatos de SMTP autorizados, separados por vírgula.
SMTP_ALLOWED_HOSTS=
# Proxies confiáveis que acrescentam ao X-Forwarded-For (gateway=1, NPM+gateway=2). 0 usa REMOTE_ADDR.
TRUSTED_PROXY_COUNT=0
